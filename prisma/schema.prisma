generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  firstName       String?
  lastName        String?
  password        String?   // null for OAuth users
  language        String    @default("fr")
  theme           String    @default("dark")
  bannerUrl       String?
  bannerOffsetY   Int       @default(50)
  smartRating     Boolean   @default(true)
  isPublic        Boolean   @default(false)
  videoLoop       Boolean   @default(true)
  videoLoopDelay  Int       @default(500)
  hiddenStats     String    @default("[]")
  enforcePublicStats Boolean @default(false)
  dashboardGrid   String?
  voiceSettings   String?   // JSON string storing { inputDeviceId, outputDeviceId, voiceIsolation, autoDucking, speakingThreshold, audioQuality }
  badge           String?   // "verified", "pro", "creator", "vip", "dev", "moderator"
  showBadge       Boolean   @default(true)
  riotGameName    String?
  riotConnected   Boolean   @default(false)
  riotPuuid       String?
  onboardingDone  Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  accounts        Account[]
  sessions        Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// CMS (AppControl Staging -> Prod)
// ==========================================

model News {
  id            String   @id @default(cuid())
  title         String
  nodes         String   // JSON contenant l'arbre de décision
  currentNodeId String?
  isDraft       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Agent {
  id          String   @id @default(cuid())
  uuid        String   @unique
  name        String
  role        String
  iconUrl     String?
  abilities   String   // JSON contenant les descriptions riches des compétences
  isDraft     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Map {
  id          String   @id @default(cuid())
  uuid        String   @unique
  name        String
  splashUrl   String?
  isDraft     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Banner {
  id          String   @id @default(cuid())
  name        String
  wideArtUrl  String
  isDraft     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// Analytics & Media Metrics
// ==========================================

model PageVisit {
  id        String   @id @default(cuid())
  path      String
  pageName  String   @default("Accueil")
  userAgent String?
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
}

model MediaLoad {
  id        String   @id @default(cuid())
  mediaKey  String
  mediaType String   @default("video")
  bytesSent BigInt   @default(0)
  createdAt DateTime @default(now())

  @@index([mediaKey])
  @@index([createdAt])
}

// ==========================================
// LFG Salons & Modération (Neon DB)
// ==========================================

model Lobby {
  id               String                 @id @default(cuid())
  leaderName       String
  leaderTag        String
  leaderRank       String
  leaderRankUrl    String?
  leaderRankTier   Int                    @default(12)
  isLeaderPrivate  Boolean                @default(false)
  leaderAvatar     String?
  mode             String                 @default("Compétitif")
  roleNeeded       String                 @default("[\"Tous Rôles\"]")
  micRequired      String                 @default("yes")
  maxSlots         Int                    @default(5)
  currentSlots     Int                    @default(1)
  note             String?
  region           String                 @default("EU / Paris")
  lobbyLevel       String                 @default("Or")
  lobbyLevelTier   Int                    @default(12)
  membersData      String                 @default("[]")
  voiceMembersData String                 @default("[]")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  expiresAt        DateTime               @default(now())
  messages         LobbyMessage[]
  transcripts      LobbyVoiceTranscript[]

  @@index([createdAt])
  @@index([expiresAt])
}

model LobbyMessage {
  id           String   @id @default(cuid())
  lobbyId      String
  senderName   String
  senderTag    String
  senderAvatar String?
  content      String
  isToxic      Boolean  @default(false)
  createdAt    DateTime @default(now())

  lobby        Lobby    @relation(fields: [lobbyId], references: [id], onDelete: Cascade)

  @@index([lobbyId])
}

model LobbyVoiceTranscript {
  id         String   @id @default(cuid())
  lobbyId    String
  senderName String
  senderTag  String
  content    String
  isToxic    Boolean  @default(false)
  createdAt  DateTime @default(now())

  lobby      Lobby    @relation(fields: [lobbyId], references: [id], onDelete: Cascade)

  @@index([lobbyId])
}

