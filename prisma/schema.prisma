generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  firstName       String?
  lastName        String?
  password        String?   // null for OAuth users
  language        String    @default("fr")
  theme           String    @default("dark")
  bannerUrl       String?
  bannerOffsetY   Int       @default(50)
  smartRating     Boolean   @default(true)
  isPublic        Boolean   @default(false)
  riotGameName    String?
  riotConnected   Boolean   @default(false)
  riotPuuid       String?
  onboardingDone  Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  accounts        Account[]
  sessions        Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// CMS (AppControl Staging -> Prod)
// ==========================================

model News {
  id            String   @id @default(cuid())
  title         String
  nodes         String   // JSON contenant l'arbre de décision
  currentNodeId String?
  isDraft       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Agent {
  id          String   @id @default(cuid())
  uuid        String   @unique
  name        String
  role        String
  iconUrl     String?
  abilities   String   // JSON contenant les descriptions riches des compétences
  isDraft     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Map {
  id          String   @id @default(cuid())
  uuid        String   @unique
  name        String
  splashUrl   String?
  isDraft     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Banner {
  id          String   @id @default(cuid())
  name        String
  wideArtUrl  String
  isDraft     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
